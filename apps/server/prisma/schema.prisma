// ModelStacker 数据模型
// 枚举值（status/kind/type/currency 等）以字符串存储，code 定义见 @model-stacker/data
//
// ⚠️ 本项目不使用 migrations：调整表结构直接改本文件，然后执行 `pnpm db:push` 同步。
// 禁止提交任何 prisma/migrations/ 目录（详见根目录 AGENTS.md）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  nickname    String
  avatarUrl   String?
  email       String?
  phone       String?
  qq          String?
  wechat      String?
  permissions String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  stacks      Stack[]
  wips        Wip[]
  supplementRequests DataSupplementRequest[]

  @@map("user")
}

model Manufacturer {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  fullName    String?
  country     String?
  website     String?
  description String?
  logoUrl     String?
  status      String   @default("ACTIVE")
  dataSource  String?
  reviewStatus String  @default("PENDING")
  reviewDate  DateTime?
  reviewerId  Int?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
  articles    Article[]
  stacks      Stack[]

  @@index([name])
  @@map("manufacturer")
}

model Theme {
  id        Int      @id @default(autoincrement())
  parentId  Int?
  parent    Theme?   @relation("ThemeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Theme[]  @relation("ThemeTree")
  name      String
  level     Int      @default(0)
  path      String
  sortOrder Int      @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]
  stacks    Stack[]

  @@index([parentId])
  @@index([name])
  @@index([path])
  @@map("theme")
}

model Product {
  id             Int          @id @default(autoincrement())
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  manufacturerId Int
  theme          Theme?       @relation(fields: [themeId], references: [id], onDelete: SetNull)
  themeId        Int?
  name           String
  officialName   String?
  modelNo        String?
  kind           String       @default("MODEL")
  modelTypes     String?
  material       String?
  accessoryMaterials String?
  toolType       String?
  scale          String?
  year           Int?
  releaseDate    DateTime?
  description    String?
  manuals        String?
  photos         String?
  tags           String?
  status         String       @default("ON_SALE")
  dataSource     String?
  manualsSource  String?
  photosSource   String?
  reviewStatus   String       @default("PENDING")
  reviewDate     DateTime?
  reviewerId     Int?
  reviewNote     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  prices         PriceRecord[]
  stacks         Stack[]
  wips           Wip[]
  articles       Article[]
  relationsFrom  ProductRelation[] @relation("ProductRelationsFrom")
  relationsTo    ProductRelation[] @relation("ProductRelationsTo")

  @@index([manufacturerId])
  @@index([themeId])
  @@index([name])
  @@index([kind, modelTypes])
  @@map("product")
}

model PriceRecord {
  id         Int      @id @default(autoincrement())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  Int
  price      Float
  currency   String   @default("CNY")
  source     String   @default("MANUAL")
  sourceUrl  String?
  note       String?
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("price_record")
}

// 用户提交的厂家资料（方案B：独立的「提交箱」，审核通过后合并进 Manufacturer）
// 与 DataSupplementRequest（堆积一键补库申请）不同：这里提交完整厂家资料条目。
model ManufacturerSubmission {
  id          Int      @id @default(autoincrement())
  // 提交人 ID（无 Prisma 反向关系，查询提交数据时直接按 userId 过滤）
  userId      Int
  name        String
  fullName    String?
  country     String?
  website     String?
  description String?
  logoUrl     String?
  dataSource  String?
  // 提交人补充说明
  note        String?
  reviewStatus String  @default("PENDING")
  reviewDate  DateTime?
  reviewerId  Int?
  reviewNote  String?
  // 审核通过并建库后回填：关联的正式厂家 ID
  linkedManufacturerId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, reviewStatus])
  @@index([reviewStatus])
  @@index([linkedManufacturerId])
  @@map("manufacturer_submission")
}

// 用户提交的产品资料（方案B：独立的「提交箱」，审核通过后合并进 Product）
// 提交产品不强制关联已有厂家：有则填 manufacturerId，没有可填 manufacturerName 自由文本，
// 审核建库 / 建厂家后回填关联（与堆积-资料库解耦口径一致）。
model ProductSubmission {
  id             Int      @id @default(autoincrement())
  userId         Int
  // 关联的已有厂家 ID（可选，不强绑定）
  manufacturerId Int?
  // 厂家名（未关联已有厂家时填写，作为厂家匹配/新建依据）
  manufacturerName String?
  themeId        Int?
  name           String
  officialName   String?
  modelNo        String?
  kind           String   @default("MODEL")
  modelTypes     String?
  material       String?
  accessoryMaterials String?
  toolType       String?
  scale          String?
  year           Int?
  releaseDate    DateTime?
  description    String?
  manuals        String?
  photos         String?
  tags           String?
  dataSource     String?
  manualsSource  String?
  photosSource   String?
  note           String?
  reviewStatus   String   @default("PENDING")
  reviewDate     DateTime?
  reviewerId     Int?
  reviewNote     String?
  // 审核通过并建库后回填：关联的正式产品 / 厂家 ID
  linkedProductId      Int?
  linkedManufacturerId Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, reviewStatus])
  @@index([reviewStatus])
  @@index([manufacturerId])
  @@index([themeId])
  @@index([linkedProductId])
  @@map("product_submission")
}

model Stack {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  // 与资料库的关联（不强绑定，均可选）
  // - 资料库有对应产品则关联 product；没有则用 itemName / manufacturerName 自由填写，
  //   并可通过 DataSupplementRequest 一键申请补充资料，审核建库后自动回填绑定。
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId     Int?
  manufacturer  Manufacturer?   @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  manufacturerId Int?
  category      Theme?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId    Int?
  itemName      String?
  manufacturerName String?
  modelNo          String?
  wip           Wip?     @relation(fields: [wipId], references: [id], onDelete: SetNull)
  wipId         Int?
  purchasedAt   DateTime @default(now())
  purchasePrice Float?
  currency      String   @default("CNY")
  channel       String?
  status        String   @default("UNSTARTED")
  stage         String?
  location      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  supplementRequests DataSupplementRequest[]

  @@index([userId, purchasedAt])
  @@index([productId])
  @@index([manufacturerId])
  @@index([categoryId])
  @@index([wipId])
  @@map("stack")
}

model DataSupplementRequest {
  id                   Int      @id @default(autoincrement())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               Int
  stack                Stack    @relation(fields: [stackId], references: [id], onDelete: Cascade)
  stackId              Int
  type                 String   @default("PRODUCT")
  name                 String
  manufacturerName     String?
  note                 String?
  reviewStatus         String   @default("PENDING")
  reviewDate           DateTime?
  reviewerId           Int?
  reviewNote           String?
  linkedProductId      Int?
  linkedManufacturerId Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId, reviewStatus])
  @@index([stackId])
  @@index([linkedProductId])
  @@map("data_supplement_request")
}

model Wip {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  product    Product  @relation(fields: [productId], references: [id])
  productId  Int
  startedAt  DateTime @default(now())
  stage      String   @default("UNASSEMBLED")
  status     String   @default("WIP")
  photos     String?
  notes      String?
  stacks     Stack[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, status])
  @@index([productId])
  @@map("wip")
}

model ProductRelation {
  id               Int      @id @default(autoincrement())
  product          Product  @relation("ProductRelationsFrom", fields: [productId], references: [id], onDelete: Cascade)
  productId        Int
  relatedProduct   Product  @relation("ProductRelationsTo", fields: [relatedProductId], references: [id], onDelete: Cascade)
  relatedProductId Int
  relationType     String   @default("COMPETITOR")
  note             String?
  createdAt        DateTime @default(now())

  @@unique([productId, relatedProductId, relationType])
  @@index([productId])
  @@index([relatedProductId])
  @@map("product_relation")
}

model Article {
  id            Int            @id @default(autoincrement())
  type          String         @default("TRIVIA")
  title         String
  content       String
  sourceUrl     String?
  products      Product[]
  manufacturers Manufacturer[]
  tags          String?
  status        String         @default("DRAFT")
  dataSource    String?
  reviewStatus  String         @default("PENDING")
  reviewDate    DateTime?
  reviewerId    Int?
  reviewNote    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([type, status])
  @@map("article")
}
