// ModelStacker 数据模型
// 枚举值（status/kind/type/currency 等）以字符串存储，code 定义见 @model-stacker/data

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nickname  String
  avatarUrl String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stacks    Stack[]
  wips      Wip[]

  @@map("user")
}

model Manufacturer {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  fullName    String?
  country     String?
  website     String?
  description String?
  logoUrl     String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
  articles    Article[]

  @@index([name])
  @@map("manufacturer")
}

model Theme {
  id        Int      @id @default(autoincrement())
  parentId  Int?
  parent    Theme?   @relation("ThemeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Theme[]  @relation("ThemeTree")
  name      String
  level     Int      @default(0)
  path      String
  sortOrder Int      @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]

  @@index([parentId])
  @@index([name])
  @@index([path])
  @@map("theme")
}

model Product {
  id             Int          @id @default(autoincrement())
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  manufacturerId Int
  theme          Theme?       @relation(fields: [themeId], references: [id], onDelete: SetNull)
  themeId        Int?
  name           String
  modelNo        String?
  kind           String       @default("MODEL")
  modelTypes     String?
  material       String?
  accessoryMaterials String?
  toolType       String?
  scale          String?
  year           Int?
  releaseDate    DateTime?
  description    String?
  manualUrl      String?
  photos         String?
  tags           String?
  status         String       @default("ON_SALE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  prices         PriceRecord[]
  stacks         Stack[]
  wips           Wip[]
  articles       Article[]
  relationsFrom  ProductRelation[] @relation("ProductRelationsFrom")
  relationsTo    ProductRelation[] @relation("ProductRelationsTo")

  @@index([manufacturerId])
  @@index([themeId])
  @@index([name])
  @@index([kind, modelTypes])
  @@map("product")
}

model PriceRecord {
  id         Int      @id @default(autoincrement())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  Int
  price      Float
  currency   String   @default("CNY")
  source     String   @default("MANUAL")
  sourceUrl  String?
  note       String?
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("price_record")
}

model Stack {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  product       Product  @relation(fields: [productId], references: [id])
  productId     Int
  wip           Wip?     @relation(fields: [wipId], references: [id], onDelete: SetNull)
  wipId         Int?
  purchasedAt   DateTime @default(now())
  purchasePrice Float?
  currency      String   @default("CNY")
  channel       String?
  status        String   @default("UNSTARTED")
  stage         String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, purchasedAt])
  @@index([productId])
  @@index([wipId])
  @@map("stack")
}

model Wip {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  product    Product  @relation(fields: [productId], references: [id])
  productId  Int
  startedAt  DateTime @default(now())
  stage      String   @default("UNASSEMBLED")
  status     String   @default("WIP")
  photos     String?
  notes      String?
  stacks     Stack[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, status])
  @@index([productId])
  @@map("wip")
}

model ProductRelation {
  id               Int      @id @default(autoincrement())
  product          Product  @relation("ProductRelationsFrom", fields: [productId], references: [id], onDelete: Cascade)
  productId        Int
  relatedProduct   Product  @relation("ProductRelationsTo", fields: [relatedProductId], references: [id], onDelete: Cascade)
  relatedProductId Int
  relationType     String   @default("COMPETITOR")
  note             String?
  createdAt        DateTime @default(now())

  @@unique([productId, relatedProductId, relationType])
  @@index([productId])
  @@index([relatedProductId])
  @@map("product_relation")
}

model Article {
  id            Int            @id @default(autoincrement())
  type          String         @default("TRIVIA")
  title         String
  content       String
  sourceUrl     String?
  products      Product[]
  manufacturers Manufacturer[]
  tags          String?
  status        String         @default("DRAFT")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([type, status])
  @@map("article")
}
