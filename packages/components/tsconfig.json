{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "noEmit": true,
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "useDefineForClassFields": true
  },
  "include": ["src"]
}
